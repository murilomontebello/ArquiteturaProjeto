

WIDTH=16;
DEPTH=256;

ADDRESS_RADIX=DEC;
DATA_RADIX=BIN;

CONTENT BEGIN
    0   : 0101001000000101;  -- 5205h  ADDI R1,R0,5
    1   : 0101010000000011;  -- 5403h  ADDI R2,R0,3
    2   : 0000011001010000;  -- 0650h  ADD  R3,R1,R2
    3   : 0001100001010000;  -- 1850h  SUB  R4,R1,R2
    4   : 0010101001010000;  -- 2A50h  AND  R5,R1,R2
    5   : 0011110001010000;  -- 3C50h  OR   R6,R1,R2
    6   : 0100111010001000;  -- 4E88h  SLT  R7,R2,R1
    7   : 0111011000011110;  -- 761Eh  ST   R3,R0,30
    8   : 0110100000011110;  -- 681Eh  LD   R4,R0,30
    9   : 1000100011000001;  -- 88C1h  BEQ  R4,R3,1 (tomado, pula 10)
    10  : 0101111000011111;  -- 5E1Fh  ADDI R7,R0,31 (pulada)
    11  : 1000001010000001;  -- 8281h  BEQ  R1,R2,1 (nao tomado)
    12  : 0101110110000001;  -- 5D81h  ADDI R6,R6,1
    13  : 1001001010000001;  -- 9281h  BNE  R1,R2,1 (tomado, pula 14)
    14  : 0101101000011111;  -- 5A1Fh  ADDI R5,R0,31 (pulada)
    15  : 1001001001000001;  -- 9241h  BNE  R1,R1,1 (nao tomado)
    16  : 0101001001111111;  -- 527Fh  ADDI R1,R1,-1
    17  : 1010000000010001;  -- A011h  JMP  17 (fim)
    [18..255] : 0000000000000000;
END;
